# Choose: openai-compatible or anthropic
AI_PROVIDER=openai-compatible

# OpenAI-compatible examples:
# OpenAI: https://api.openai.com/v1
# Gemini OpenAI-compatible endpoint: use the current endpoint from Google's official docs
# OpenRouter: https://openrouter.ai/api/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Anthropic native adapter:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

PORT=3000

# Workspace access is restricted to this folder.
WORKSPACE_DIR=./workspace

# Optional current web search (Tavily)
TAVILY_API_KEY=

RATE_LIMIT_PER_MINUTE=30
MAX_REQUEST_BYTES=5000000
KNOWLEDGE_DIR=./knowledge

# Optional MCP servers. Only tools listed in allowTools are exposed to the AI.
# stdio example (runs a local process; only configure servers you trust):
# MCP_SERVERS=[{"name":"docs","transport":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","./workspace"],"allowTools":["list_directory","read_file"]}]
# Streamable HTTP example:
# MCP_SERVERS=[{"name":"myserver","transport":"http","url":"https://your-mcp-server.example/mcp","headers":{"Authorization":"Bearer YOUR_TOKEN"},"allowTools":["search"]}]
MCP_SERVERS=

# Required for account sessions: generate with `openssl rand -hex 32`.
SESSION_SECRET=
# Set true only when serving over HTTPS.
COOKIE_SECURE=false

# Optional browser inspection. Install a Playwright browser with:
# npx playwright install chromium
# Only these hostnames (and their subdomains) may be visited.
BROWSER_ALLOWED_DOMAINS=example.com

# Image generation (OpenAI Images API or a compatible endpoint)
IMAGE_API_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1

# Video frame extraction (FFmpeg must be installed on the server)
FFMPEG_PATH=ffmpeg

# Video sampling: how many frames to look at, and how many seconds of video to use (3-120).
VIDEO_MAX_FRAMES=8
VIDEO_MAX_SECONDS=24

# Production: set NODE_ENV=production, use HTTPS, a 64+ character secret,
# and COOKIE_SECURE=true. Keep the app behind a trusted TLS reverse proxy.

# Reply and memory limits
# Longest answer the model may write (256-32000). Higher costs more and is slower.
MAX_REPLY_TOKENS=8192
# How many earlier messages are sent with each new message (10-200).
MAX_HISTORY_MESSAGES=60
# Let the assistant run short JavaScript in the Docker sandbox during a reply to check its work.
# Off by default. Runs have no internet access and a 5-second limit, but are still code runs.
AUTO_RUN_CODE=false

# Reasoning: off (default), standard, or deep. Deep uses more time and tokens.
REASONING_LEVEL=off
